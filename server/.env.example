PORT=3001
NODE_ENV=development
ADMIN_API_KEY=
ENABLE_DEV_PAYMENT=true

# WeChat Pay API v3 Native payment. Keep false until every field is configured.
WECHAT_PAY_ENABLED=false
REPORT_PRICE_FEN=1990
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
WECHAT_PAY_PRIVATE_KEY_PEM=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=./certs/wechatpay_platform_certificate.pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PEM=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/payments/wechat/notify

# Alipay WAP payment. Use sandbox gateway for sandbox apps.
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PRIVATE_KEY_PEM=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_PUBLIC_KEY_PEM=
ALIPAY_NOTIFY_URL=https://api.example.com/api/payments/alipay/notify
ALIPAY_RETURN_URL=http://localhost:5173/pay
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_KEY_TYPE=PKCS8

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_PROVIDER=mock
FRONTEND_ORIGIN=http://localhost:5173

# Local development defaults. Set to false after configuring real services.
USE_MOCK_DATABASE=true
USE_MOCK_AI=true
